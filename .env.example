# Database Configuration
# Replace with your own local PostgreSQL credentials
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/agate_nwis

# Frontend Origin for CORS (default allows all in dev)
FRONTEND_URL=*

# ==============================================================================
# AI & LLM Model Provider Configuration (SIH 2026 Mandate)
# Choose between Google Gemini, Anthropic Claude, OpenAI, or local Ollama.
# Mode options: 'auto' (detects by available key), 'gemini', 'claude', 'openai', 'ollama'
# ==============================================================================
LLM_PROVIDER=auto

# Provider detection only checks whether a variable is non-empty, so a fake
# placeholder value here makes /api/ai/status report the provider as
# "connected" while every real call 401s. Leave these commented out and
# uncomment the one you have a genuine key for.

# Option 1: Google Gemini (Get free API key at https://aistudio.google.com)
# GEMINI_API_KEY=
# gemini-1.5-flash was retired by Google and 404s on generateContent. Verified
# working as of 2026-09-29: gemini-3.5-flash, gemini-3.7-flash, gemini-2.5-flash.
GEMINI_MODEL_NAME=gemini-3.5-flash

# Option 2: Anthropic Claude (Get API key at https://console.anthropic.com)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001

# Option 3: OpenAI (Get API key at https://platform.openai.com)
# OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 4: Local Ollama (Free, Private & 100% Offline — run 'ollama run llama3')
OLLAMA_ENDPOINT=http://localhost:11434/v1
OLLAMA_MODEL_NAME=llama3

# Legacy / Universal Fallback Key (Backward compatible)
# LLM_API_KEY=
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL_NAME=llama3

# ==============================================================================
# Embeddings (AGATE knowledge layer)
# ==============================================================================
# Remote embedding provider — no local model is used.
# Vectors are stored at EMBEDDING_DIM and every query must use the same width.
# Changing EMBEDDING_DIM invalidates every stored vector; after changing it,
# re-run:  ./venv/Scripts/python.exe scripts/backfill_embeddings.py --force
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Semantic search needs an embedding provider, and Claude has no embeddings
# endpoint — so a Gemini key is required even when Claude serves the chat.
# Without it, retrieval degrades to BM25 lexical ranking.
# GEMINI_API_KEY=
